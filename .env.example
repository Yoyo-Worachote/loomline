# Copy to .env only if you need to change a default. No secrets are required.
# The server does not read .env automatically; use `node --env-file=.env dist/server.mjs`.

# HTTP + WebSocket port
PORT=8787
# Interface to bind. 0.0.0.0 allows other devices on your LAN to join.
HOST=0.0.0.0
# Directory for room snapshots (rooms survive a restart). Set to "memory" to disable.
DATA_DIR=./data
# Hours of inactivity before a room is deleted
ROOM_TTL_HOURS=12
# Comma-separated list of allowed browser origins. Empty = same host only.
ALLOWED_ORIGINS=
# Set to 1 only behind a trusted reverse proxy (uses X-Forwarded-For for rate limits)
TRUST_PROXY=0
# Header the host sets to the visitor's address (with TRUST_PROXY=1), e.g. cf-connecting-ip
CLIENT_IP_HEADER=
