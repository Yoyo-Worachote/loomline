{
  "name": "loomline",
  "version": "0.1.0",
  "private": true,
  "description": "Loomline — an original multiplayer flip-and-draw transit weaving game for the browser.",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "concurrently -k -n server,web \"npm:dev:server\" \"npm:dev:web\"",
    "dev:server": "tsx watch src/server/main.ts",
    "dev:web": "vite",
    "build": "vite build && node scripts/build-server.mjs",
    "start": "node dist/server.mjs",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "simulate": "tsx scripts/simulate.ts",
    "check": "npm run lint && npm run typecheck && npm run test && npm run build"
  },
  "dependencies": {
    "@fontsource/bai-jamjuree": "^5.3.0",
    "@fontsource/ibm-plex-sans-thai": "^5.3.0",
    "qrcode-generator": "^2.0.4",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "ws": "^8.23.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.13",
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/ws": "^8.18.2",
    "@vitejs/plugin-react": "^4.7.0",
    "concurrently": "^9.2.5",
    "esbuild": "^0.25.12",
    "eslint": "^9.39.5",
    "eslint-plugin-react-hooks": "^5.2.0",
    "globals": "^17.14.0",
    "jsdom": "^26.1.0",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.74.0",
    "vite": "^6.4.6",
    "vitest": "^5.1.1"
  }
}
